# Скопируйте в .env и заполните на сервере. НИКОГДА не коммитьте .env в GitHub!
PORT=3000
DATABASE_URL=postgres://evsa:CHANGE_ME@localhost:5432/evsa
# Токен бота выдаёт @BotFather. Хранить ТОЛЬКО в переменных окружения сервера.
