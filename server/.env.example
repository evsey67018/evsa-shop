# Длинная случайная строка для подписи сессий
JWT_SECRET=
# Telegram ID администраторов через запятую
ADMIN_TG_IDS=
# Курс: сколько рублей стоит 1 звезда
STAR_RATE_RUB=1.79
SITE_ORIGIN=https://evsey67018.github.io
